# ==============================================================================
# FIDELIO — VARIABLES D'ENVIRONNEMENT DE PRODUCTION & DISTANTES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES DISTANTE : TURSO (libSQL / SQLite Serverless pour Cloudflare & Node)
# ------------------------------------------------------------------------------
# Par défaut en local : si ces variables sont vides, l'application utilise automatiquement
# le fichier SQLite local : data/fidelio.sqlite (zéro configuration requise).
#
# En production sur Internet (Cloudflare / VPS / Docker / Render) :
# Renseignez ces 2 variables pour connecter la base persistante Turso (compatible 100% SQLite).
#
# Démarche d'obtention gratuite en 2 minutes :
# 1. Créez un compte gratuit sur https://turso.tech
# 2. Créez votre base : turso db create fidelio-db
# 3. Récupérez l'URL : turso db show fidelio-db --url
# 4. Créez votre token : turso db tokens create fidelio-db
#
TURSO_DATABASE_URL=libsql://fidelio-db-[username].turso.io
TURSO_AUTH_TOKEN=votre_token_secret_turso_ici

# ------------------------------------------------------------------------------
# 2. CONFIGURATION DU SERVEUR DE PRODUCTION NODE (VPS / Docker / Render)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. DOMAINE & URL PUBLIQUE DU SITE
# ------------------------------------------------------------------------------
# Utilisé pour la génération des liens QR code et des pass Wallet mobiles
PUBLIC_APP_URL=https://fidelio.dz

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE PAGES (Déploiement Serverless)
# ------------------------------------------------------------------------------
# Si vous déployez sur Cloudflare Pages :
# Ajoutez simplement TURSO_DATABASE_URL et TURSO_AUTH_TOKEN dans :
# Dashboard Cloudflare > Pages > fidelio-app > Settings > Environment variables
